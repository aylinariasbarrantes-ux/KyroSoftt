@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isLogin = string.Equals(controller, "Login", StringComparison.OrdinalIgnoreCase);
    var nombreUsuario = Context.Session.GetString("NombreUsuario");
    var rol = Context.Session.GetString("Rol");
    var toastTitle = TempData["ToastTitle"]?.ToString();
    var toastSuccess = TempData["ToastSuccess"]?.ToString();
    var toastError = TempData["ToastError"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - KyroSoft</title>

    <script>
        (() => {
            const storedTheme = localStorage.getItem('kyro-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const useDark = storedTheme ? storedTheme === 'dark' : prefersDark;

            document.documentElement.classList.toggle('dark', useDark);
            document.documentElement.style.colorScheme = useDark ? 'dark' : 'light';
        })();
    </script>

    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-zinc-50 text-zinc-950 antialiased transition-colors duration-300 selection:bg-brand-100 selection:text-brand-900 dark:bg-zinc-950 dark:text-zinc-100 dark:selection:bg-brand-800 dark:selection:text-brand-100">
    <div id="toastRoot" class="pointer-events-none fixed right-4 top-4 z-[9999] flex w-[calc(100%-2rem)] max-w-sm flex-col gap-3">
        @if (!string.IsNullOrWhiteSpace(toastSuccess) && !string.IsNullOrWhiteSpace(toastTitle))
        {
            <div data-toast class="pointer-events-auto relative flex translate-x-6 scale-95 items-start gap-3 overflow-hidden rounded-xl border border-emerald-200 bg-white p-4 text-sm opacity-0 shadow-lg shadow-zinc-950/10 transition-all dark:border-emerald-900/70 dark:bg-zinc-900 dark:shadow-black/30 duration-300 ease-out" role="status">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                </div>
                <div class="min-w-0 flex-1 pt-0.5">
                    <p class="font-semibold text-zinc-950 dark:text-zinc-100">@toastTitle</p>
                    <p class="mt-0.5 text-zinc-600 dark:text-zinc-400">@toastSuccess</p>
                </div>
                <button type="button" data-toast-close class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-zinc-400 transition-all duration-200 hover:rotate-90 hover:bg-zinc-100 hover:text-zinc-700 active:scale-90 dark:text-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-zinc-200" aria-label="Cerrar notificación">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                </button>
                <div data-toast-progress class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-100 bg-emerald-500 transition-transform duration-[4500ms] ease-linear"></div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(toastError) && !string.IsNullOrWhiteSpace(toastTitle))
        {
            <div data-toast class="pointer-events-auto relative flex translate-x-6 scale-95 items-start gap-3 overflow-hidden rounded-xl border border-red-200 bg-white p-4 text-sm opacity-0 shadow-lg shadow-zinc-950/10 transition-all dark:border-red-900/70 dark:bg-zinc-900 dark:shadow-black/30 duration-300 ease-out" role="alert">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert preview-icon"><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg>
                </div>
                <div class="min-w-0 flex-1 pt-0.5">
                    <p class="font-semibold text-zinc-950 dark:text-zinc-100">@toastTitle</p>
                    <p class="mt-0.5 text-zinc-600 dark:text-zinc-400">@toastError</p>
                </div>
                <button type="button" data-toast-close class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-zinc-400 transition-all duration-200 hover:rotate-90 hover:bg-zinc-100 hover:text-zinc-700 active:scale-90 dark:text-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-zinc-200" aria-label="Cerrar notificación">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                </button>
                <div data-toast-progress class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-100 bg-red-500 transition-transform duration-[4500ms] ease-linear"></div>
            </div>
        }
    </div>
    @if (isLogin)
    {
        <button type="button" data-theme-toggle class="group fixed right-4 top-4 z-50 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 bg-white/90 text-zinc-700 shadow-sm backdrop-blur transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-brand-200 hover:bg-brand-50 hover:text-brand-700 hover:shadow-md active:translate-y-0 active:scale-95 dark:border-zinc-800 dark:bg-zinc-900/90 dark:text-zinc-300 dark:hover:border-brand-900 dark:hover:bg-brand-950 dark:hover:text-brand-200" aria-label="Activar modo oscuro" title="Cambiar tema">
            <svg data-theme-icon-sun viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute h-4 w-4 scale-100 rotate-0 opacity-100 transition-all duration-300 dark:scale-75 dark:rotate-90 dark:opacity-0" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
            <svg data-theme-icon-moon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute h-4 w-4 scale-75 -rotate-90 opacity-0 transition-all duration-300 dark:scale-100 dark:rotate-0 dark:opacity-100" aria-hidden="true"><path d="M20.985 12.486A9 9 0 1 1 11.514 3.015c.36-.02.57.426.35.71A6 6 0 0 0 20.274 12.135c.284-.22.73-.01.71.35Z" /></svg>
        </button>
        <main class="min-h-screen">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="min-h-screen bg-zinc-50 transition-colors duration-300 dark:bg-zinc-950">
            <aside class="hidden border-r border-zinc-200 bg-white transition-colors duration-300 dark:border-zinc-800 dark:bg-zinc-950 lg:flex lg:min-h-screen lg:flex-col">
                <div class="flex h-16 items-center gap-3 border-b border-zinc-200 px-6 dark:border-zinc-800">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-600 p-2 shadow-sm dark:bg-brand-500" title="Universidad Técnica Nacional">
                        <img src="~/images/utn-logo.svg" alt="Logo de la Universidad Técnica Nacional" class="h-8 w-auto" />
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold leading-none tracking-tight">KyroSoft</p>
                        <p class="mt-1 truncate text-xs text-zinc-500 dark:text-zinc-400">Universidad Técnica Nacional</p>
                    </div>
                </div>

                <nav class="flex-1 space-y-1 p-4 text-sm">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 rounded-lg bg-brand-50 px-3 py-2.5 font-medium text-brand-700 ring-1 ring-inset ring-brand-100 transition-colors duration-200 hover:bg-brand-100 dark:bg-brand-950 dark:text-brand-200 dark:ring-brand-900 dark:hover:bg-brand-900">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                            <rect width="7" height="9" x="3" y="3" rx="1" />
                            <rect width="7" height="5" x="14" y="3" rx="1" />
                            <rect width="7" height="9" x="14" y="12" rx="1" />
                            <rect width="7" height="5" x="3" y="16" rx="1" />
                        </svg>
                        Inicio
                    </a>
                    <a href="#" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                            <path d="M8 2v4" />
                            <path d="M16 2v4" />
                            <rect width="18" height="18" x="3" y="4" rx="2" />
                            <path d="M3 10h18" />
                        </svg>
                        Reservas
                    </a>
                    <a href="#" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                            <path d="M9 2h6" />
                            <path d="M10 9h4" />
                            <path d="M10 2v5.4a2 2 0 0 1-.4 1.2L4.8 15A4 4 0 0 0 8 21h8a4 4 0 0 0 3.2-6l-4.8-6.4a2 2 0 0 1-.4-1.2V2" />
                        </svg>
                        Laboratorios
                    </a>
                    @if (string.Equals(rol, "Administrador", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="#" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                            Usuarios
                        </a>
                    }
                </nav>

                <div class="border-t border-zinc-200 p-4 dark:border-zinc-800">
                    <div class="mb-3 flex items-center gap-3 rounded-xl px-2 py-2">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700 dark:bg-brand-950 dark:text-brand-200">
                            @(string.IsNullOrWhiteSpace(nombreUsuario) ? "U" : nombreUsuario[..1].ToUpperInvariant())
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@(nombreUsuario ?? "Usuario")</p>
                            <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">@(rol ?? "Sesión activa")</p>
                        </div>
                    </div>
                    <form asp-controller="Login" asp-action="Logout" method="post">
                        <button type="submit" class="group inline-flex h-9 w-full items-center justify-center gap-2 rounded-md border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-700 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-red-900 dark:hover:bg-red-950/50 dark:hover:text-red-300 active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" x2="9" y1="12" y2="12" />
                            </svg>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </aside>

            <div class="min-w-0">
                <header class="sticky top-0 z-20 flex h-18 items-center justify-between border-b border-zinc-200 bg-white/90 px-4 backdrop-blur transition-colors duration-300 dark:border-zinc-800 dark:bg-zinc-950/90 md:px-8">
                    <div class="flex items-center">
                        <img src="~/images/utn-logo.svg" alt="Logo Universidad Técnica Nacional" class="h-16 w-auto block dark:hidden " />
                        <img src="~/images/utn-logo-white.svg" alt="Logo Universidad Técnica Nacional" class="h-16 w-auto hidden dark:!block" />
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" data-theme-toggle class="group relative inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-brand-200 hover:bg-brand-50 hover:text-brand-700 hover:shadow active:translate-y-0 active:scale-95 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-brand-900 dark:hover:bg-brand-950 dark:hover:text-brand-200" aria-label="Activar modo oscuro" title="Cambiar tema">
                            <svg data-theme-icon-sun viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute h-4 w-4 scale-100 rotate-0 opacity-100 transition-all duration-300 dark:scale-75 dark:rotate-90 dark:opacity-0" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
                            <svg data-theme-icon-moon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute h-4 w-4 scale-75 -rotate-90 opacity-0 transition-all duration-300 dark:scale-100 dark:rotate-0 dark:opacity-100" aria-hidden="true"><path d="M20.985 12.486A9 9 0 1 1 11.514 3.015c.36-.02.57.426.35.71A6 6 0 0 0 20.274 12.135c.284-.22.73-.01.71.35Z" /></svg>
                        </button>
                        <span class="hidden rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 sm:inline-flex">@(rol ?? "Usuario")</span>
                        <form asp-controller="Login" asp-action="Logout" method="post">
                            <button type="submit" class="group inline-flex h-9 items-center justify-center gap-2 rounded-md border border-zinc-200 bg-white px-3 text-sm font-medium text-zinc-700 shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-700 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-red-900 dark:hover:bg-red-950/50 dark:hover:text-red-300 active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" x2="9" y1="12" y2="12" /></svg>
                                <span class="hidden sm:inline">Cerrar sesión</span>
                            </button>
                        </form>
                    </div>
                </header>

                <main class="p-4 md:p-8">
                    @RenderBody()
                </main>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
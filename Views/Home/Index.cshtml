@{
    ViewData["Title"] = "Inicio";
    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Usuario";
    var rol = Context.Session.GetString("Rol") ?? "Usuario";
}

<div class="mx-auto max-w-7xl space-y-8">
    <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-medium text-brand-600 dark:text-brand-300">Panel principal</p>
            <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100 sm:text-3xl">Hola, @nombreUsuario 👋</h1>
            <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Aquí tendrás un resumen de la actividad y disponibilidad de los laboratorios.</p>
        </div>
        <button type="button" class="group inline-flex h-10 items-center justify-center gap-2 rounded-md bg-brand-600 px-4 text-sm font-medium text-white shadow-sm transition-all dark:bg-brand-500 dark:text-white duration-200 ease-out hover:-translate-y-0.5 hover:bg-brand-700 dark:hover:bg-brand-400 hover:shadow-md active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 dark:focus-visible:ring-brand-400 focus-visible:ring-offset-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:rotate-90" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
            Nueva reserva
        </button>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all dark:border-zinc-800 dark:bg-zinc-900 duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:hover:border-zinc-700">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Reservas hoy</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-200">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg>
                </div>
            </div>
            <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
            <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Sin reservas registradas todavía</p>
        </article>

        <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all dark:border-zinc-800 dark:bg-zinc-900 duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:hover:border-zinc-700">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Laboratorios</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900 dark:text-brand-200">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M9 2h6" /><path d="M10 9h4" /><path d="M10 2v5.4a2 2 0 0 1-.4 1.2L4.8 15A4 4 0 0 0 8 21h8a4 4 0 0 0 3.2-6l-4.8-6.4a2 2 0 0 1-.4-1.2V2" /></svg>
                </div>
            </div>
            <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
            <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Pendientes de registrar</p>
        </article>

        <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all dark:border-zinc-800 dark:bg-zinc-900 duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:hover:border-zinc-700">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Disponibles</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-violet-50 text-violet-700 dark:bg-violet-950 dark:text-violet-300">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M20 6 9 17l-5-5" /></svg>
                </div>
            </div>
            <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
            <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">La disponibilidad aparecerá aquí</p>
        </article>

        <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all dark:border-zinc-800 dark:bg-zinc-900 duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:hover:border-zinc-700">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Tu perfil</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </div>
            </div>
            <p class="mt-4 text-lg font-semibold tracking-tight">@rol</p>
            <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Sesión iniciada como @nombreUsuario</p>
        </article>
    </section>

    <section class="grid gap-6 xl:grid-cols-[1.6fr_1fr]">
        <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 transition-shadow duration-300 hover:shadow-md">
            <div class="flex items-center justify-between border-b border-zinc-200 px-5 py-4 dark:border-zinc-800">
                <div>
                    <h2 class="text-sm font-semibold">Próximas reservas</h2>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Las reservas más cercanas aparecerán en esta sección.</p>
                </div>
                <button type="button" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium shadow-sm transition-all duration-200 hover:border-zinc-300 hover:bg-zinc-100 hover:shadow active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-zinc-800">Ver todas</button>
            </div>
            <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /><path d="m9 16 2 2 4-4" /></svg>
                </div>
                <h3 class="mt-4 text-sm font-medium">No hay reservas próximas</h3>
                <p class="mt-1 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">Cuando se creen reservas, podrás ver aquí el laboratorio, la fecha, la hora y el estado.</p>
            </div>
        </div>

        <aside class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all dark:border-zinc-800 dark:bg-zinc-900 duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:hover:border-zinc-700">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-white dark:bg-brand-500 dark:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" /><path d="m9 12 2 2 4-4" /></svg>
                </div>
                <div>
                    <h2 class="text-sm font-semibold">Estado del sistema</h2>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Entorno local de desarrollo</p>
                </div>
            </div>

            <div class="mt-5 space-y-3">
                <div class="flex items-center justify-between rounded-lg border border-zinc-200 p-3 dark:border-zinc-800">
                    <span class="text-sm text-zinc-600 dark:text-zinc-400">Autenticación</span>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 dark:text-emerald-400"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Activa</span>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-zinc-200 p-3 dark:border-zinc-800">
                    <span class="text-sm text-zinc-600 dark:text-zinc-400">Base de datos</span>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 dark:text-emerald-400"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>SQL Server</span>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-zinc-200 p-3 dark:border-zinc-800">
                    <span class="text-sm text-zinc-600 dark:text-zinc-400">Interfaz</span>
                    <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">Tailwind + shadcn style</span>
                </div>
            </div>
        </aside>
    </section>
</div>
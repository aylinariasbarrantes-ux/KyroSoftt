                    </div>
                    <a asp-controller="Reserva" asp-action="Index" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium shadow-sm transition-all duration-200 hover:border-zinc-300 hover:bg-zinc-100 hover:shadow active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-zinc-800">

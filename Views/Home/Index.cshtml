                </div>
                <h2 class="mt-4 text-sm font-semibold">Horarios cada 30 minutos</h2>
                <p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
                    Puedes seleccionar horarios como 8:00 a. m.,
                    8:30 a. m., 9:00 a. m. o 9:30 a. m.
                </p>
            </article>
            <article class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 sm:col-span-2 lg:col-span-1">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                    </svg>
                </div>
                <h2 class="mt-4 text-sm font-semibold">Acceso de usuario</h2>
                <p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
                    Tu perfil tiene acceso a la consulta de disponibilidad.
                    La administración queda reservada para administradores.
                </p>
            </article>
        </section>
        <div id="availabilityModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-zinc-950/60 p-4 backdrop-blur-sm" aria-hidden="true">
            <div class="relative w-full max-w-xl overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xl dark:border-zinc-800 dark:bg-zinc-900">
                <div class="flex items-start justify-between border-b border-zinc-200 px-5 py-4 dark:border-zinc-800 sm:px-6">
                    <div>
                        <p class="text-sm font-medium text-brand-600 dark:text-brand-300">Laboratorios</p>
                        <h2 class="mt-1 text-lg font-semibold text-zinc-950 dark:text-zinc-100">Consultar disponibilidad</h2>
                        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Completa los datos del horario que deseas consultar.</p>
                    </div>
                    <button type="button" id="closeAvailabilityModal" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-zinc-400 transition-all hover:rotate-90 hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-zinc-200" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </div>
                <form id="availabilityForm" class="space-y-5 px-5 py-5 sm:px-6" novalidate>
                    <div>
                        <label for="availabilityLaboratorio" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Laboratorio</label>
                        <select id="availabilityLaboratorio" required class="h-11 w-full rounded-xl border border-zinc-300 bg-white px-3 text-sm text-zinc-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100">
                            <option value="">Selecciona un laboratorio</option>
                            @foreach (var laboratorio in laboratorios)
                            {
                                <option value="@laboratorio.Id">@laboratorio.Nombre — @laboratorio.Ubicacion</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="availabilityFecha" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Fecha</label>
                        <input id="availabilityFecha" type="date" required class="h-11 w-full rounded-xl border border-zinc-300 bg-white px-3 text-sm text-zinc-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100" />
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label for="horaInicio" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Hora inicial</label>
                            <select id="horaInicio" name="horaInicio" required class="h-11 w-full rounded-xl border border-zinc-300 bg-white px-3 text-sm text-zinc-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100">
                                <option value="">Seleccione una hora</option>
                            </select>
                        </div>
                        <div>
                            <label for="horaFin" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Hora final</label>
                            <select id="horaFin" name="horaFin" required class="h-11 w-full rounded-xl border border-zinc-300 bg-white px-3 text-sm text-zinc-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100">
                                <option value="">Seleccione una hora</option>
                            </select>
                        </div>
                    </div>
                    <p class="-mt-2 text-xs text-zinc-500 dark:text-zinc-400">
                        Los horarios se seleccionan en intervalos de
                        30 minutos.
                    </p>
                    <div id="availabilityResult" class="hidden rounded-xl border p-4" role="status" aria-live="polite">
                        <div class="flex items-start gap-3">
                            <div id="availabilityResultIcon" class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
                            </div>
                            <div class="min-w-0 flex-1">
                                <p id="availabilityResultTitle" class="text-sm font-semibold">
                                </p>
                                <p id="availabilityResultMessage" class="mt-1 text-sm leading-6">
                                </p>
                                <button type="button" id="availabilityReserveButton" class="mt-4 hidden h-10 items-center justify-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400">
                                    Reservar
                                </button>
                            </div>
                        </div>
                    </div>
                    <p id="availabilityFormError" class="hidden text-sm font-medium text-red-600 dark:text-red-400">
                    </p>
                    <div class="flex flex-col-reverse gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800 sm:flex-row sm:justify-end">
                        <button type="button" id="cancelAvailabilityModal" class="h-10 rounded-lg border border-zinc-200 bg-white px-4 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800">
                            Cancelar
                        </button>
                        <button type="submit" id="availabilitySubmitButton" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-brand-500 dark:hover:bg-brand-400">
                            <span>Consultar disponibilidad</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("availabilityModal");
            if (!modal) return;
            const openButton = document.getElementById("openAvailabilityModal");
            const closeButton = document.getElementById("closeAvailabilityModal");
            const cancelButton = document.getElementById("cancelAvailabilityModal");
            const form = document.getElementById("availabilityForm");
            const laboratorioInput = document.getElementById("availabilityLaboratorio");
            const fechaInput = document.getElementById("availabilityFecha");
            const inicioInput = document.getElementById("horaInicio");
            const finInput = document.getElementById("horaFin");
            const submitButton = document.getElementById("availabilitySubmitButton");
            const result = document.getElementById("availabilityResult");
            const resultIcon = document.getElementById("availabilityResultIcon");
            const resultTitle = document.getElementById("availabilityResultTitle");
            const resultMessage = document.getElementById("availabilityResultMessage");
            const reserveButton = document.getElementById("availabilityReserveButton");
            const formError = document.getElementById("availabilityFormError");
            const endpoint = '@Url.Action("ConsultarDisponibilidad", "Reserva")';
            const now = new Date();
            const todayIso =
                `${now.getFullYear()}-` +
                `${String(now.getMonth() + 1).padStart(2, "0")}-` +
                `${String(now.getDate()).padStart(2, "0")}`;
            fechaInput.min = todayIso;

            function cargarHorasDisponibles() {
                const HORA_APERTURA = 8;
                const HORA_CIERRE = 22;
                for (let hora = HORA_APERTURA; hora < HORA_CIERRE; hora++) {
                    [0, 30].forEach(minuto => {
                        const hora24 = String(hora).padStart(2, "0");
                        const minutos = String(minuto).padStart(2, "0");
                        const valor = `${hora24}:${minutos}`;
                        const hora12 = hora % 12 || 12;
                        const periodo = hora >= 12 ? "p. m." : "a. m.";
                        const texto = `${hora12}:${minutos} ${periodo}`;
                        inicioInput.add(
                            new Option(texto, valor)
                        );
                    });
                }
                for (let hora = HORA_APERTURA; hora <= HORA_CIERRE; hora++) {
                    [0, 30].forEach(minuto => {
                        if (hora === HORA_CIERRE && minuto === 30) {
                            return;
                        }
                        if (hora === HORA_APERTURA && minuto === 0) {
                            return;
                        }
                        const hora24 = String(hora).padStart(2, "0");
                        const minutos = String(minuto).padStart(2, "0");
                        const valor = `${hora24}:${minutos}`;
                        const hora12 = hora % 12 || 12;
                        const periodo = hora >= 12 ? "p. m." : "a. m.";
                        const texto = `${hora12}:${minutos} ${periodo}`;
                        finInput.add(
                            new Option(texto, valor)
                        );
                    });
                }
            }
            cargarHorasDisponibles();

            function clearResult() {
                result.className = "hidden rounded-xl border p-4";
                resultIcon.className =
                    "mt-0.5 flex h-9 w-9 shrink-0 " +
                    "items-center justify-center rounded-full";
                resultIcon.innerHTML = "";
                resultTitle.textContent = "";
                resultMessage.textContent = "";
                reserveButton.classList.add("hidden");
                reserveButton.classList.remove("inline-flex");
                formError.classList.add("hidden");
                formError.textContent = "";
            }

            function openModal() {
                clearResult();
                if (!fechaInput.value) {
                    fechaInput.value = todayIso;
                }
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );
                document.body.classList.add("overflow-hidden");
                setTimeout(() => {
                    laboratorioInput.focus();
                }, 0);
            }

            function closeModal() {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );
                document.body.classList.remove("overflow-hidden");
            }

            function showAvailable() {
                result.className =
                    "rounded-xl border border-emerald-200 " +
                    "bg-emerald-50 p-4 text-emerald-900 " +
                    "dark:border-emerald-900 " +
                    "dark:bg-emerald-950/40 " +
                    "dark:text-emerald-100";
                resultIcon.className =
                    "mt-0.5 flex h-9 w-9 shrink-0 " +
                    "items-center justify-center rounded-full " +
                    "bg-emerald-100 text-emerald-700 " +
                    "dark:bg-emerald-900 " +
                    "dark:text-emerald-200";
                resultIcon.innerHTML = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                `;
                resultTitle.textContent = "Laboratorio disponible";
                resultMessage.textContent = "El laboratorio está disponible en la fecha y el horario seleccionados.";
                reserveButton.classList.remove("hidden");
                reserveButton.classList.add("inline-flex");
            }

            function showUnavailable(message) {
                result.className =
                    "rounded-xl border border-amber-200 " +
                    "bg-amber-50 p-4 text-amber-950 " +
                    "dark:border-amber-900 " +
                    "dark:bg-amber-950/40 " +
                    "dark:text-amber-100";
                resultIcon.className =
                    "mt-0.5 flex h-9 w-9 shrink-0 " +
                    "items-center justify-center rounded-full " +
                    "bg-amber-100 text-amber-700 " +
                    "dark:bg-amber-900 " +
                    "dark:text-amber-200";
                resultIcon.innerHTML = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 8v4" />
                        <path d="M12 16h.01" />
                    </svg>
                `;
                resultTitle.textContent = "Laboratorio no disponible";
                const detail =
                    message
                        ? `${message} `
                        : "";
                resultMessage.textContent = `${detail}Por favor, selecciona otras opciones.`;
                reserveButton.classList.add("hidden");
                reserveButton.classList.remove("inline-flex");
            }

            function esIntervaloDeTreintaMinutos(hora) {
                if (!hora) {
                    return false;
                }
                const partes = hora.split(":");
                if (partes.length !== 2) {
                    return false;
                }
                const minutos = Number(partes[1]);
                return minutos === 0 ||
                       minutos === 30;
            }
            [
                laboratorioInput,
                fechaInput,
                inicioInput,
                finInput
            ].forEach(input => {
                input.addEventListener(
                    "change",
                    clearResult
                );
            });
            form.addEventListener(
                "submit",
                async event => {
                    event.preventDefault();
                    clearResult();
                    const laboratorioId = laboratorioInput.value;
                    const fecha = fechaInput.value;
                    const horaInicio = inicioInput.value;
                    const horaFin = finInput.value;
                    if (
                        !laboratorioId ||
                        !fecha ||
                        !horaInicio ||
                        !horaFin
                    ) {
                        formError.textContent = "Completa todos los campos para realizar la consulta.";
                        formError.classList.remove("hidden");
                        return;
                    }
                    if (fecha < todayIso) {
                        formError.textContent = "La fecha seleccionada no puede ser anterior al día de hoy.";
                        formError.classList.remove("hidden");
                        return;
                    }
                    if (
                        !esIntervaloDeTreintaMinutos(
                            horaInicio
                        ) ||
                        !esIntervaloDeTreintaMinutos(
                            horaFin
                        )
                    ) {
                        formError.textContent = "Las horas deben seleccionarse en intervalos de 30 minutos (:00 o :30).";
                        formError.classList.remove("hidden");
                        return;
                    }
                    if (horaInicio >= horaFin) {
                        formError.textContent = "La hora final debe ser posterior a la hora inicial.";
                        formError.classList.remove("hidden");
                        return;
                    }
                    submitButton.disabled = true;
                    submitButton
                        .querySelector("span")
                        .textContent =
                            "Consultando...";
                    try {
                        const params =
                            new URLSearchParams({
                                laboratorioId,
                                fecha,
                                horaInicio,
                                horaFin
                            });
                        const response =
                            await fetch(
                                `${endpoint}?${params.toString()}`,
                                {
                                    method: "GET",
                                    headers: {
                                        "Accept": "application/json"
                                    }
                                }
                            );
                        let data = {};
                        try {
                            data = await response.json();
                        }
                        catch {
                            data = {};
                        }
                        const disponible =
                            data.disponible ??
                            data.Disponible ??
                            false;
                        const motivo =
                            data.motivo ??
                            data.Motivo ??
                            data.mensaje ??
                            data.Mensaje ??
                            "";
                        if (
                            response.ok &&
                            disponible
                        ) {
                            showAvailable();
                        }
                        else {
                            showUnavailable(
                                motivo ||
                                "El laboratorio no se encuentra disponible."
                            );
                        }
                    }
                    catch (error) {
                        console.error(
                            error
                        );
                        formError.textContent = "No fue posible consultar la disponibilidad. Intenta nuevamente.";
                        formError.classList.remove("hidden");
                    }
                    finally {
                        submitButton.disabled = false;
                        submitButton
                            .querySelector("span")
                            .textContent =
                                "Consultar disponibilidad";
                    }
                }
            );
            openButton?.addEventListener(
                "click",
                openModal
            );
            closeButton?.addEventListener(
                "click",
                closeModal
            );
            cancelButton?.addEventListener(
                "click",
                closeModal
            );
            modal.addEventListener(
                "click",
                event => {
                    if (
                        event.target === modal
                    ) {
                        closeModal();
                    }
                }
            );
            document.addEventListener(
                "keydown",
                event => {
                    if (
                        event.key === "Escape" &&
                        !modal.classList.contains(
                            "hidden"
                        )
                    ) {
                        closeModal();
                    }
                }
            );
            reserveButton.addEventListener(
                "click",
                () => {
                    // Futuro:
                    // continuar al proceso de reserva.
                }
            );
        });
    </script>
}
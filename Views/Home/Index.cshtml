@{
    ViewData["Title"] = "Inicio";
    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Usuario";
    var rol = Context.Session.GetString("Rol") ?? "Usuario";
    var laboratorios = ViewBag.Laboratorios as List<Laboratorio> ?? new List<Laboratorio>();
    if (rol == "Administrador")
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutUsuario.cshtml";
    }
}
<div class="mx-auto max-w-7xl space-y-8">
    @if (rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
    {
        <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-sm font-medium text-brand-600 dark:text-brand-300">Panel principal</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100 sm:text-3xl">Hola, @nombreUsuario 👋</h1>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Aquí tendrás un resumen de la actividad y disponibilidad de los laboratorios.</p>
            </div>
            <a asp-controller="Reserva" asp-action="Index" class="group inline-flex h-10 items-center justify-center gap-2 rounded-md bg-brand-600 px-4 text-sm font-medium text-white shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 dark:bg-brand-500 dark:text-white dark:hover:bg-brand-400 dark:focus-visible:ring-brand-400">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <rect width="18" height="18" x="3" y="4" rx="2" />
                    <path d="M3 10h18" />
                </svg>
                Reservas
            </a>
        </section>

        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <a asp-controller="Reserva" asp-action="Index" class="block rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Reservas</p>
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-700 dark:bg-brand-900 dark:text-brand-200">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                            <path d="M8 2v4" />
                            <path d="M16 2v4" />
                            <rect width="18" height="18" x="3" y="4" rx="2" />
                            <path d="M3 10h18" />
                        </svg>
                    </div>
                </div>
                <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
                <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Consulta el calendario y los horarios programados</p>
            </a>
            <a href="~/laboratorio" class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Laboratorios</p>
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900 dark:text-brand-200">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                            <path d="M9 2h6" />
                            <path d="M10 9h4" />
                            <path d="M10 2v5.4a2 2 0 0 1-.4 1.2L4.8 15A4 4 0 0 0 8 21h8a4 4 0 0 0 3.2-6l-4.8-6.4a2 2 0 0 1-.4-1.2V2" />
                        </svg>
                    </div>
                </div>
                <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
                <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Pendientes de registrar</p>
            </a>
            <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Disponibles</p>
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-violet-50 text-violet-700 dark:bg-violet-950 dark:text-violet-300">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                    </div>
                </div>
                <p class="mt-4 text-3xl font-semibold tracking-tight">0</p>
                <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">La disponibilidad aparecerá aquí</p>
            </article>
            <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Tu perfil</p>
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300">

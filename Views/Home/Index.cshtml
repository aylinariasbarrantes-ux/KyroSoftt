    else
    {
        <section class="relative overflow-hidden rounded-3xl border border-zinc-200 bg-white px-6 py-8 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 sm:px-8 sm:py-10 lg:px-12">
            <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-100/70 blur-3xl dark:bg-brand-950/60">
            </div>
            <div class="relative gap-8 lg:items-center">
                <div>
                    <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:border-brand-900 dark:bg-brand-950 dark:text-brand-200">
                        <span class="h-2 w-2 rounded-full bg-emerald-500">
                        </span>
                        Consulta de laboratorios
                    </span>
                    <h1 class="mt-5 max-w-2xl text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100 sm:text-4xl">Hola, @nombreUsuario 👋</h1>
                    <p class="mt-3 text-sm leading-6 text-zinc-500 dark:text-zinc-400 sm:text-base">
                        Consulta si un laboratorio se encuentra disponible para la fecha y el horario que necesitas antes de

@model List<Laboratorio>

@{
    ViewData["Title"] = "Laboratorios";

    var rol = Context.Session.GetString("Rol") ?? "Usuario";
    var esAdministrador = rol.Equals(
        "Administrador",
        StringComparison.OrdinalIgnoreCase
    );

    Layout = esAdministrador
        ? "~/Views/Shared/_Layout.cshtml"
        : "~/Views/Shared/_LayoutUsuario.cshtml";

    var total = Model.Count;

    var fueraDeServicio = Model.Count(l =>
        string.Equals(
            l.Estado,
            "Fuera de servicio",
            StringComparison.OrdinalIgnoreCase
        )
    );
}

<div class="mx-auto max-w-7xl space-y-8">

    <a asp-controller="Home"
       asp-action="Index"
       class="group inline-flex h-10 items-center justify-center gap-2 rounded-md bg-brand-600 px-4 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md dark:bg-brand-500 dark:hover:bg-brand-400">

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" class="h-4 w-4" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
        </svg>

        Volver al inicio
    </a>

    <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-medium text-brand-600 dark:text-brand-300">
                Catálogo
            </p>

            <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100 sm:text-3xl">
                Laboratorios
            </h1>

            <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
                @if (esAdministrador)
                {
                    <text>Consulta los laboratorios y administra su disponibilidad.</text>
                }
                else
                {
                    <text>Consulta los laboratorios registrados y su estado actual.</text>
                }
            </p>
        </div>

        <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-700 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200">
            @total en total
        </span>
    </section>

    @* Mensajes de éxito y error *@

    @if (TempData["Exito"] is string mensajeExito)
    {
        <div data-alerta-temporal
             role="status"
             class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-medium text-emerald-800 shadow-sm transition-opacity duration-500 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" class="h-5 w-5 shrink-0" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="m8 12 3 3 5-6" />
            </svg>

            <span>@mensajeExito</span>
        </div>
    }

    @if (TempData["Error"] is string mensajeError)
    {
        <div role="alert"
             class="flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-medium text-red-800 shadow-sm dark:border-red-900 dark:bg-red-950 dark:text-red-300">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" class="h-5 w-5 shrink-0" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4m0 4h.01" />
            </svg>

            <span>@mensajeError</span>
        </div>
    }

    <section class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">

        <div class="flex items-center justify-between border-b border-zinc-200 px-5 py-4 dark:border-zinc-800">
            <div>
                <h2 class="text-sm font-semibold">
                    Lista de laboratorios
                </h2>

                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                    @total registrado(s) en el sistema.
                </p>
            </div>

            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300">
                <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
                @fueraDeServicio fuera de servicio
            </span>
        </div>

        @if (total == 0)
        {
            <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
                <h3 class="text-sm font-medium">
                    No hay laboratorios registrados
                </h3>

                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
                    Los laboratorios aparecerán aquí cuando se agreguen al sistema.
                </p>
            </div>
        }
        else
        {
            var indice = 0;
            var ultimaFila = total - 1;

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-zinc-200 text-xs uppercase tracking-tight text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">

                            <th scope="col" class="px-5 py-3 text-start font-medium">
                                Nombre
                            </th>

                            <th scope="col" class="px-5 py-3 text-start font-medium">
                                Ubicación
                            </th>

                            <th scope="col" class="px-5 py-3 text-start font-medium">
                                Capacidad
                            </th>

                            <th scope="col" class="px-5 py-3 text-start font-medium">
                                Estado
                            </th>

                            <th scope="col" class="px-5 py-3 text-end font-medium">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var laboratorio in Model)
                        {
                            var esUltima = indice == ultimaFila;
                            indice++;

                            var estaFuera = string.Equals(
                            laboratorio.Estado,
                            "Fuera de servicio",
                            StringComparison.OrdinalIgnoreCase
                            );

                            <tr class="@(esUltima ? "" : "border-b border-zinc-200 dark:border-zinc-800") transition-colors duration-200">

                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900 dark:text-brand-200">

                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 class="h-4 w-4" aria-hidden="true">
                                                <path d="M9 2h6" />
                                                <path d="M10 9h4" />
                                                <path d="M10 2v5.4a2 2 0 0 1-.4 1.2L4.8 15A4 4 0 0 0 8 21h8a4 4 0 0 0 3.2-6l-4.8-6.4a2 2 0 0 1-.4-1.2V2" />
                                            </svg>
                                        </div>

                                        <span class="font-medium text-zinc-950 dark:text-zinc-100">
                                            @laboratorio.Nombre
                                        </span>
                                    </div>
                                </td>

                                <td class="px-5 py-4 text-zinc-600 dark:text-zinc-400">
                                    @laboratorio.Ubicacion
                                </td>

                                <td class="whitespace-nowrap px-5 py-4 text-zinc-600 dark:text-zinc-400">
                                    @laboratorio.Capacidad personas
                                </td>

                                <td class="px-5 py-4">
                                    @if (estaFuera)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
                                            <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
                                            Fuera de servicio
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                            Habilitado
                                        </span>
                                    }
                                </td>

                                @if (esAdministrador)
                                {
                                    <td class="px-5 py-4 text-end">

                                        <form asp-controller="Laboratorio"
                                              asp-action="CambiarEstado"
                                              method="post"
                                              class="inline-flex formulario-estado">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="laboratorioId"
                                                   value="@laboratorio.Id" />

                                            <input type="hidden"
                                                   name="nuevoEstado"
                                                   value="@(estaFuera ? "Habilitado" : "Fuera de servicio")" />

                                            @if (estaFuera)
                                            {
                                                <button type="submit"
                                                        data-nombre="@laboratorio.Nombre"
                                                        data-accion="habilitar"
                                                        style="background-color:#059669;color:#ffffff;"
                                                        class="inline-flex h-9 items-center justify-center rounded-lg px-4 text-xs font-semibold shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                                                    Habilitar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        data-nombre="@laboratorio.Nombre"
                                                        data-accion="deshabilitar"
                                                        style="background-color:#dc2626;color:#ffffff;"
                                                        class="inline-flex h-9 items-center justify-center rounded-lg px-4 text-xs font-semibold shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                                                    Fuera de servicio
                                                </button>
                                            }
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <td class="px-5 py-4 text-end">

                                        @if (estaFuera)
                                        {
                                            <button type="button"
                                                    disabled
                                                    class="inline-flex h-9 cursor-not-allowed items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 px-3 text-xs font-semibold text-zinc-400 opacity-70 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-600">
                                                Reservar
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Home"
                                               asp-action="Index"
                                               asp-route-crearReserva="1"
                                               asp-route-laboratorioId="@laboratorio.Id"
                                               class="inline-flex h-9 items-center justify-center rounded-lg bg-brand-600 px-3 text-xs font-semibold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md dark:bg-brand-500 dark:hover:bg-brand-400">
                                                Reservar
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@* Modal personalizado de HU-9 *@

@if (esAdministrador)
{
    <div id="modalEstado"
         class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
         aria-hidden="true">

        <div id="modalEstadoPanel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="modalEstadoTitulo"
             aria-describedby="modalEstadoDescripcion"
             tabindex="-1"
             class="w-full max-w-md rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xl dark:border-zinc-800 dark:bg-zinc-900">

            <div class="flex items-start justify-between gap-4">

                <div id="modalEstadoIcono"
                     class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-600">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-6 w-6"
                         aria-hidden="true">
                        <path d="M12 9v4m0 4h.01" />
                        <path d="M10.3 3.9 2 18.3A2 2 0 0 0 3.7 21h16.6a2 2 0 0 0 1.7-2.7L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                    </svg>
                </div>

                <button id="cerrarModalEstado"
                        type="button"
                        aria-label="Cerrar ventana"
                        class="rounded-lg p-2 text-zinc-400 transition-colors hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-800">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5"
                         aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mt-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
                    Administración de laboratorios
                </p>

                <h2 id="modalEstadoTitulo"
                    class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-100">
                    Cambiar estado
                </h2>

                <p id="modalEstadoDescripcion"
                   class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                </p>
            </div>

            <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                <button id="cancelarModalEstado"
                        type="button"
                        class="inline-flex h-10 items-center justify-center rounded-lg border border-zinc-200 bg-white px-5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700">
                    Cancelar
                </button>

                <button id="confirmarModalEstado"
                        type="button"
                        style="background-color:#dc2626;color:#ffffff;"
                        class="inline-flex h-10 items-center justify-center rounded-lg px-5 text-sm font-semibold shadow-sm transition-all hover:opacity-90">
                    Confirmar
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Los mensajes de éxito desaparecen después de 5 segundos.
            document.querySelectorAll("[data-alerta-temporal]").forEach(function (alerta) {
                setTimeout(function () {
                    alerta.classList.add("opacity-0");

                    setTimeout(function () {
                        alerta.remove();
                    }, 500);
                }, 5000);
            });

            const modal = document.getElementById("modalEstado");

            if (!modal) {
                return;
            }

            const panel = document.getElementById("modalEstadoPanel");
            const titulo = document.getElementById("modalEstadoTitulo");
            const descripcion = document.getElementById("modalEstadoDescripcion");
            const icono = document.getElementById("modalEstadoIcono");
            const confirmar = document.getElementById("confirmarModalEstado");
            const cancelar = document.getElementById("cancelarModalEstado");
            const cerrar = document.getElementById("cerrarModalEstado");

            let formularioSeleccionado = null;
            let botonAnterior = null;
            let enviando = false;

            function abrirModal(formulario, boton) {
                if (enviando) return;

                formularioSeleccionado = formulario;
                botonAnterior = boton;

                const nombre = boton.dataset.nombre || "este laboratorio";
                const accion = boton.dataset.accion;

                if (accion === "habilitar") {
                    titulo.textContent = "¿Habilitar laboratorio?";

                    descripcion.textContent =
                        "¿Estás seguro de que deseas habilitar " +
                        nombre +
                        "? El laboratorio volverá a estar disponible para nuevas reservas.";

                    confirmar.textContent = "Sí, habilitar";
                    confirmar.style.backgroundColor = "#059669";

                    icono.className =
                        "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600";
                } else {
                    titulo.textContent = "¿Poner fuera de servicio?";

                    descripcion.textContent =
                        "¿Estás seguro de que deseas poner " +
                        nombre +
                        " fuera de servicio? No se podrán realizar nuevas reservas hasta que vuelva a habilitarse.";

                    confirmar.textContent = "Sí, fuera de servicio";
                    confirmar.style.backgroundColor = "#dc2626";

                    icono.className =
                        "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-600";
                }

                modal.classList.remove("hidden");
                modal.classList.add("flex");
                modal.setAttribute("aria-hidden", "false");

                document.body.style.overflow = "hidden";
                cancelar.focus();
            }

            function cerrarModal() {
                if (enviando) return;

                modal.classList.add("hidden");
                modal.classList.remove("flex");
                modal.setAttribute("aria-hidden", "true");

                document.body.style.overflow = "";

                formularioSeleccionado = null;

                if (botonAnterior) {
                    botonAnterior.focus();
                }
            }

            document.querySelectorAll(".formulario-estado").forEach(function (formulario) {
                formulario.addEventListener("submit", function (evento) {
                    if (enviando) return;

                    evento.preventDefault();

                    const boton = evento.submitter ||
                        formulario.querySelector('button[type="submit"]');

                    abrirModal(formulario, boton);
                });
            });

            confirmar.addEventListener("click", function () {
                if (!formularioSeleccionado || enviando) return;

                enviando = true;
                confirmar.disabled = true;
                confirmar.textContent = "Guardando...";

                // Envía el POST original con su token antifalsificación.
                formularioSeleccionado.submit();
            });

            cancelar.addEventListener("click", cerrarModal);
            cerrar.addEventListener("click", cerrarModal);

            modal.addEventListener("click", function (evento) {
                if (evento.target === modal) {
                    cerrarModal();
                }
            });

            document.addEventListener("keydown", function (evento) {
                if (modal.classList.contains("hidden")) return;

                if (evento.key === "Escape") {
                    cerrarModal();
                }

                if (evento.key === "Tab") {
                    const elementos = [cerrar, cancelar, confirmar];
                    const actual = elementos.indexOf(document.activeElement);

                    if (evento.shiftKey && actual === 0) {
                        evento.preventDefault();
                        confirmar.focus();
                    } else if (!evento.shiftKey && actual === 2) {
                        evento.preventDefault();
                        cerrar.focus();
                    }
                }
            });
        });
    </script>
}
